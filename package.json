{
  "name": "dsh-magpie-bridge",
  "version": "0.1.0",
  "description": "Embed magpie's official Web UI in DSH and expose its CLI to agents",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "magpie",
    "llm",
    "openai-compatible"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Kairo Verge",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.1.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@types/node": "^22.20.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/Aevisen/dsh-magpie-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aevisen/dsh-magpie-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Aevisen/dsh-magpie-bridge/issues"
  }
}
